# Copy to .env.beta (gitignored) and fill in. The alert scripts under scripts/alerts/
# source it automatically; anything already exported in your shell wins over these.
#
#   cp .env.beta.example .env.beta && chmod 600 .env.beta

# Project API key for the tenant you are sending to.
export MW_API_KEY=

# OTLP gRPC endpoint. TLS turns on automatically for https:// and for port 443.
# Local capture-metrics is plaintext: 127.0.0.1:4321
export MW_OTLP_ENDPOINT=https://<tenant>.middleware.io:443
